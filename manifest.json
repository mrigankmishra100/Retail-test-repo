{
  "version": 1,
  "deployment_status": "planned",
  "name": "retail-inventory",
  "deployment_target": "generative_ai",
  "authentication": "NO_AUTH_CONFIG",
  "description": "Five-service retail application/resource plan aligned with retail-v4-20261009.4 saved images. This is not an executable recipe in the current Deployment Lab engine; readiness must block it until the listed capabilities are implemented.",
  "blockers": [
    "hosted-database-connectivity",
    "database-schema-initialization",
    "database-wallet-distribution",
    "structured-json-environment-bindings",
    "hosted-invoke-url-bindings",
    "policy-object-upload",
    "supplier-policy-documents"
  ],
  "resources": {
    "database": {
      "type": "database",
      "storage_gbs": 20,
      "ecpu": 2
    },
    "wallets": {
      "type": "bucket"
    },
    "policies": {
      "type": "bucket"
    },
    "notifications": {
      "type": "topic"
    }
  },
  "generated_secrets": [
    "retail-service-key",
    "supplier-service-key",
    "mcp-retail-key",
    "mcp-supplier-key"
  ],
  "database_initialization": {
    "resource": "database",
    "target": "new-empty-application-schema-only",
    "sql_files": [
      "database/schema.sql",
      "database/seed.sql"
    ],
    "migrations_for_existing_databases_only": [
      "database/migrations/001_phase5_case_persistence.sql",
      "database/migrations/002_uuid_identifier_widths.sql",
      "database/migrations/003_chat_persistence.sql",
      "database/migrations/004_agent_registry.sql"
    ],
    "runner_status": "not-implemented",
    "note": "scripts/setup_db.py is a placeholder. Fresh schema already includes migrations; do not run them again. Use a SQLcl-aware runner or reviewed SQL/PLSQL parser, not splitting statements on semicolons."
  },
  "wallet_distribution": {
    "source": "generated Autonomous Database wallet",
    "bucket": {
      "ref": "resources.wallets.name"
    },
    "object_name": "database-wallet.zip",
    "runtime_directory": "/tmp",
    "private": true
  },
  "object_uploads": [
    {
      "source_directory": "policies",
      "bucket": {
        "ref": "resources.policies.name"
      },
      "private": true,
      "prerequisite": "Supply the actual supplier policy documents; the repository policies folder currently contains only a README."
    }
  ],
