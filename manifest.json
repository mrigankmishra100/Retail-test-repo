      },
      "port": 8080,
      "health_path": "/health",
      "readiness_path": "/ready",
      "public": false,
      "resource_principal": true,
      "depends_on": [],
      "environment": {
        "APP_ENV": "development",
        "HOSTED_PROBE_MODE": "true",
        "OCI_AUTH_MODE": "resource_principal",
        "OCI_REGION": {
          "ref": "account.region"
        },
        "OCI_COMPARTMENT_ID": {
          "ref": "account.compartment_id"
        },
        "ORACLE_DB_DRIVER_MODE": "thick",
        "ORACLE_DB_DSN": {
          "ref": "resources.database.dsn"
        },
        "ORACLE_DB_USER": {
          "ref": "resources.database.user"
        },
        "ORACLE_DB_PASSWORD": {
          "ref": "resources.database.password"
