{
  "version": 1,
  "deployment_status": "planned",
  "name": "retail-inventory",
  "deployment_target": "generative_ai",
  "authentication": "NO_AUTH_CONFIG",
  "description": "Source-build deployment plan for Deployment_v4. Not yet executable by Deployment Lab; no Docker image archives are used.",
  "blockers": [
    "hosted-database-connectivity",
    "database-schema-initialization",
    "database-wallet-distribution",
    "structured-json-environment-bindings",
    "hosted-invoke-url-bindings",
    "policy-object-upload",
    "docker-build-target-support",
    "supplier-policy-documents"
  ],
  "resources": {
    "database": {
      "type": "database",
      "storage_gbs": 20,
      "ecpu": 2
    },
    "wallets": {
      "type": "bucket"
    },
    "policies": {
      "type": "bucket"
    },
    "notifications": {
      "type": "topic"
    }
  },
  "generated_secrets": [
    "retail-service-key",
    "supplier-service-key",
    "mcp-retail-key",
    "mcp-supplier-key"
  ],
  "database_initialization": {
    "resource": "database",
    "target": "new-empty-application-schema-only",
    "sql_files": [
      "database/schema.sql",
      "database/seed.sql"
    ],
    "migrations_for_existing_databases_only": [
      "database/migrations/001_phase5_case_persistence.sql",
      "database/migrations/002_uuid_identifier_widths.sql",
      "database/migrations/003_chat_persistence.sql",
      "database/migrations/004_agent_registry.sql"
    ],
    "runner_status": "not-implemented",
    "note": "scripts/setup_db.py is a placeholder. Fresh schema already includes migrations; do not run them again. Use a SQLcl-aware runner or reviewed SQL/PLSQL parser, not splitting statements on semicolons."
  },
  "wallet_distribution": {
    "source": "generated Autonomous Database wallet",
    "bucket": {
      "ref": "resources.wallets.name"
    },
    "object_name": "database-wallet.zip",
    "runtime_directory": "/tmp",
    "private": true
  },
  "object_uploads": [
    {
      "source_directory": "policies",
      "bucket": {
        "ref": "resources.policies.name"
      },
      "private": true,
      "note": "Supplier policy PDFs are not included upstream; only policies/README.md exists. Supply real policy documents before enabling policy-dependent workflows."
    }
  ],
  "services": {
    "mcp-server": {
      "image": {
        "context": ".",
        "dockerfile": "backend/Dockerfile.source",
        "target": "mcp-server"
      },
      "port": 8080,
      "health_path": "/health",
      "readiness_path": "/ready",
      "public": false,
      "resource_principal": true,
      "depends_on": [],
      "environment": {
        "APP_ENV": "development",
        "HOSTED_PROBE_MODE": "true",
        "OCI_AUTH_MODE": "resource_principal",
        "OCI_REGION": {
          "ref": "account.region"
        },
        "OCI_COMPARTMENT_ID": {
          "ref": "account.compartment_id"
        },
        "ORACLE_DB_DRIVER_MODE": "thick",
        "ORACLE_DB_DSN": {
          "ref": "resources.database.dsn"
        },
        "ORACLE_DB_USER": {
          "ref": "resources.database.user"
        },
        "ORACLE_DB_PASSWORD": {
          "ref": "resources.database.password"
        },
        "ORACLE_DB_WALLET_PASSWORD": {
          "ref": "resources.database.wallet_password"
        },
        "ORACLE_DB_WALLET_NAMESPACE": {
          "ref": "account.namespace"
        },
        "ORACLE_DB_WALLET_BUCKET": {
          "ref": "resources.wallets.name"
        },
        "ORACLE_DB_WALLET_OBJECT_NAME": {
          "ref": "resources.database.wallet_object_name"
        },
        "OCI_NAMESPACE": {
          "ref": "account.namespace"
        },
        "OCI_BUCKET_NAME": {
          "ref": "resources.policies.name"
        },
        "OCI_NOTIFICATION_TOPIC_ID": {
          "ref": "resources.notifications.id"
        },
        "OCI_NOTIFICATION_PUBLISH_ENABLED": "false",
        "OCI_NOTIFICATION_SHARED_POC_ENABLED": "false",
        "ENTERPRISE_AI_RESPONSES_ENABLED": "false",
        "ENTERPRISE_AI_CONVERSATION_STATE_ENABLED": "false",
        "ENTERPRISE_AI_FILE_SEARCH_ENABLED": "false",
        "ENTERPRISE_AI_NL2SQL_ENABLED": "false",
        "ENTERPRISE_AI_GUARDRAILS_ENABLED": "false",
        "ENTERPRISE_AI_MCP_SAFETY_ENABLED": "false",
        "ENTERPRISE_AI_AGENT_REGISTRY_ENABLED": "false",
        "ENTERPRISE_AI_MCP_REGISTRY_ENABLED": "false",
        "LANGSMITH_TRACING": "false",
        "REMOTE_MCP_ENABLED": "false",
        "REMOTE_MCP_SERVICE_KEYS": {
          "json_object": {
            "retail": {
              "ref": "secrets.mcp-retail-key"
            },
            "supplier": {
              "ref": "secrets.mcp-supplier-key"
            }
          }
        }
      }
    },
    "retail-agent": {
      "image": {
        "context": ".",
        "dockerfile": "backend/Dockerfile.source",
        "target": "retail-agent"
      },
      "port": 8080,
