  "runtime_settings": {
    "replicas_per_service": 1,
    "persist_generated_settings": "encrypted-local-run-store",
    "upload_existing_customer_config": false,
    "notification_subscriptions": [],
    "notes": [
      "Account credentials are used by the engine, not baked into service images.",
      "Generate and distribute the four distinct service/delegation keys consistently.",
      "No-auth is the OCI gateway setting; application session/agent HMAC checks remain in the retail app.",
      "Hostnames shown to users and OCI invoke bases used by agent validation are different outputs.",
      "The saved image archives preserve role-specific CMD and native Oracle Thick dependencies. Building from source needs multi-stage target support and access to the pinned base image.",
      "This main-branch plan uploads the selected saved images; it does not build images from current source. Archive SHA-256 values identify Docker-save files, not OCIR manifest digests.",
      "The newer backend/agent/MCP images add GET /status/notifications. It checks topic/subscription visibility without publishing; do not use it as a mandatory startup health probe.",
      "Notification publishing remains disabled in this plan. The separately paired Deployment Studio may enable it through private configuration; this plan does not change that engine or its defaults.",
      "Runtime IAM must cover private configuration/wallet/policy objects and, when notifications are enabled, topic read/publish and subscription inspection. A matching application identity is required."
    ]
  },
  "optional_ai": {
    "enabled": false,
    "reason": "Infrastructure-first plan; live model-assisted chat and vector search are not configured by this manifest.",
    "initial_inputs_when_enabled": [
      "model or endpoint choice",
      "customer GenAI project",
      "customer GenAI API key if using that auth mode",
      "policy documents for vector ingestion"
    ],
    "future_steps": [
      "Configure runtime model identity and permissions",
      "Create/select customer project and vector store",
      "Ingest customer policies explicitly",
      "Enable Responses/Conversations after readiness checks"
    ]
  },
  "release": "retail-v4-20261009.4",
  "image_inventory": "docker-images/manifest.json",
  "image_source_mode": "saved_archives"
