        },
        "ORACLE_DB_USER": {
          "ref": "resources.database.user"
        },
        "ORACLE_DB_PASSWORD": {
          "ref": "resources.database.password"
        },
        "ORACLE_DB_WALLET_PASSWORD": {
          "ref": "resources.database.wallet_password"
        },
        "ORACLE_DB_WALLET_NAMESPACE": {
          "ref": "account.namespace"
        },
        "ORACLE_DB_WALLET_BUCKET": {
          "ref": "resources.wallets.name"
        },
        "ORACLE_DB_WALLET_OBJECT_NAME": {
          "ref": "resources.database.wallet_object_name"
        },
        "OCI_NAMESPACE": {
          "ref": "account.namespace"
        },
        "OCI_BUCKET_NAME": {
          "ref": "resources.policies.name"
        },
        "OCI_NOTIFICATION_TOPIC_ID": {
          "ref": "resources.notifications.id"
        },
        "OCI_NOTIFICATION_PUBLISH_ENABLED": "false",
        "OCI_NOTIFICATION_SHARED_POC_ENABLED": "false",
        "ENTERPRISE_AI_RESPONSES_ENABLED": "false",
        "ENTERPRISE_AI_CONVERSATION_STATE_ENABLED": "false",
        "ENTERPRISE_AI_FILE_SEARCH_ENABLED": "false",
        "ENTERPRISE_AI_NL2SQL_ENABLED": "false",
        "ENTERPRISE_AI_GUARDRAILS_ENABLED": "false",
        "ENTERPRISE_AI_MCP_SAFETY_ENABLED": "false",
        "ENTERPRISE_AI_AGENT_REGISTRY_ENABLED": "false",
        "ENTERPRISE_AI_MCP_REGISTRY_ENABLED": "false",
        "LANGSMITH_TRACING": "false",
        "APPLICATION_ROLE": "retail-agent",
        "AGENT_SERVICE_KEY": {
          "ref": "secrets.retail-service-key"
        },
        "REMOTE_MCP_ENABLED": "true",
        "REMOTE_MCP_ENDPOINT": {
          "ref": "services.mcp-server.invoke_url"
        },
        "REMOTE_MCP_SERVICE_KEYS": {
          "json_object": {
            "retail": {
              "ref": "secrets.mcp-retail-key"
            }
          }
        }
      }
    },
