APP_ENV=development

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Oracle Enterprise AI

ENTERPRISE_AI_ENDPOINT=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com/openai/v1
ENTERPRISE_AI_MODEL_ID=google.gemini-2.5-flash
# Optional admin-approved model profiles for Agent Chat only; see docs/chat-model-evaluation.md.
# CHAT_MODEL_PROFILES=[{"id":"baseline","label":"Gemini 2.5 Flash","model_id":"google.gemini-2.5-flash","file_search":false}]
# CHAT_METRICS_PATH=runtime/chat-metrics.sqlite3
ENTERPRISE_AI_API_MODE=responses
ENTERPRISE_AI_AUTH_MODE=oci
ENTERPRISE_AI_PROJECT_ID=

ENTERPRISE_AI_RESPONSES_ENABLED=true
ENTERPRISE_AI_CONVERSATION_STATE_ENABLED=false
ENTERPRISE_AI_NL2SQL_ENABLED=true
ENTERPRISE_AI_GUARDRAILS_ENABLED=false
ENTERPRISE_AI_MCP_SAFETY_ENABLED=false
ENTERPRISE_AI_AGENT_REGISTRY_ENABLED=false
ENTERPRISE_AI_MCP_REGISTRY_ENABLED=false

# Existing resources published in Oracle Enterprise AI registries.
# Enabling a registry requires every corresponding ID used by the application.
ENTERPRISE_AI_RETAIL_AGENT_ID=
ENTERPRISE_AI_SUPPLIER_AGENT_ID=
ENTERPRISE_AI_MCP_SERVER_ID=

# LangSmith agent and LangGraph tracing

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retail-inventory-agent-poc
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# OCI

OCI_AUTH_MODE=api_key
OCI_REGION=ap-hyderabad-1
OCI_COMPARTMENT_ID=
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Oracle Database 26ai

ORACLE_DB_DSN=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_DRIVER_MODE=thin
ORACLE_DB_CONFIG_DIR=
ORACLE_DB_WALLET_PASSWORD=

# Object Storage

OCI_NAMESPACE=
OCI_BUCKET_NAME=

# OCI Cache

OCI_CACHE_ENDPOINT=
OCI_CACHE_USERNAME=
OCI_CACHE_PASSWORD=
OCI_CACHE_TLS_CA_FILE=

# OCI Notifications

OCI_NOTIFICATION_TOPIC_ID=
OCI_NOTIFICATION_PUBLISH_ENABLED=false
OCI_NOTIFICATION_SHARED_POC_ENABLED=false
OCI_NOTIFICATION_SUPPLIER_TOPICS={}
## Optional official OCI operations (no token-rate estimates)
OCI_FINOPS_ENABLED=false
# OCI_USAGE_TENANCY_ID=ocid1.tenancy...
# OCI_USAGE_REGION=ap-hyderabad-1
# OCI_APPLICATION_LOG_ID=ocid1.log...
# OCI_APPLICATION_LOG_GROUP_ID=ocid1.loggroup...

# Opt-in prompt injection checks for Agent Chat (OCI signed ApplyGuardrails).
# Requires OCI_COMPARTMENT_ID and an authorized OCI profile/principal.
ENTERPRISE_AI_GUARDRAILS_ENDPOINT=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com
ENTERPRISE_AI_GUARDRAILS_VERSION=1.0.1
ENTERPRISE_AI_GUARDRAILS_TIMEOUT_SECONDS=15
# Inactive registered RETAIL/SUPPLIER roles block local and remote execution.
AGENT_REGISTRY_ENFORCEMENT_ENABLED=false

# Source deployment: gateway can insert missing roles from AGENT_ENDPOINTS.
# Docker source targets enable these; existing inactive records are preserved.
AGENT_REGISTRY_BOOTSTRAP_ENABLED=false

# Self-hosted Langfuse: use the URL and project keys from your running instance.
# Enable only after configuring all three values; restart each server service.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=poc
LANGFUSE_RELEASE=
