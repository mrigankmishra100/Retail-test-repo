# Copy to .env only on a new checkout; never overwrite an existing .env.
# Fill in private values locally. Never commit credentials or wallets.
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:5173

# Required for live inventory and persisted case workflows.
# ORACLE_DB_DSN=your-host:1521/your-service
# ORACLE_DB_USER=your-application-schema
# ORACLE_DB_PASSWORD=your-password
# Local default is thin; the current split deployment image uses Oracle Thick.
# ORACLE_DB_DRIVER_MODE=thin
# Wallet connections may also require these (use paths on your machine):
# ORACLE_DB_CONFIG_DIR=C:/private/oracle-wallet
# ORACLE_DB_WALLET_PASSWORD=your-wallet-password

# OCI API-signing configuration for enabled OCI services.
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
# OCI_REGION=your-region
# OCI_COMPARTMENT_ID=your-compartment-ocid

# Optional policy storage; otherwise the repository policies are used.
# OCI_NAMESPACE=your-object-storage-namespace
# OCI_BUCKET_NAME=your-policy-bucket

# Optional shared Redis state. Without it, development state is in memory.
# OCI_CACHE_ENDPOINT=rediss://your-cache-host:6379
# OCI_CACHE_USERNAME=your-cache-user
# OCI_CACHE_PASSWORD=your-cache-password
# OCI_CACHE_TLS_CA_FILE=C:/private/cache-ca.pem

# Disabled by default to prevent accidental delivery from a new checkout.
# Enable only after configuring the intended audience and confirming subscriptions.
OCI_NOTIFICATION_PUBLISH_ENABLED=false
OCI_NOTIFICATION_SHARED_POC_ENABLED=false
# OCI_NOTIFICATION_TOPIC_ID=ocid1.onstopic.your-topic
# Dedicated supplier mapping (use actual supplier IDs and distinct topic OCIDs):
# OCI_NOTIFICATION_SUPPLIER_TOPICS={"SUP001":"ocid1.onstopic.supplier-topic"}

# Optional model-assisted conversation; obtain endpoint/model from the project owner.
ENTERPRISE_AI_RESPONSES_ENABLED=false
# Default chat preserves the existing OCI native Chat implementation.
ENTERPRISE_AI_API_MODE=chat
# Responses-only authentication; does not change wallet/Object Storage identity.
ENTERPRISE_AI_AUTH_MODE=oci
# For the API-key POC: mode=responses, auth_mode=genai_api_key, responses_enabled=true.
# OCI_GENAI_API_KEY=your-private-GenAI-service-key
# Keep conversation_state_enabled=false until Conversations permissions are verified.
# For OCI Responses, set mode=responses, use a model name and the project OCID.
# ENTERPRISE_AI_ENDPOINT=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com/openai/v1
# ENTERPRISE_AI_MODEL_ID=google.gemini-2.5-flash
# ENTERPRISE_AI_PROJECT_ID=ocid1.generativeaiproject.oc1.ap-hyderabad-1.your-project
# OCI_AUTH_MODE=api_key means OCI config signing, NOT a Generative AI sk- key.
# Hosted containers should use OCI_AUTH_MODE=resource_principal after access is verified.
# ENTERPRISE_AI_ENDPOINT=https://your-configured-endpoint
# ENTERPRISE_AI_MODEL_ID=your-configured-model
ENTERPRISE_AI_CONVERSATION_STATE_ENABLED=false
ENTERPRISE_AI_NL2SQL_ENABLED=false
ENTERPRISE_AI_GUARDRAILS_ENABLED=false
ENTERPRISE_AI_MCP_SAFETY_ENABLED=false
ENTERPRISE_AI_AGENT_REGISTRY_ENABLED=false
ENTERPRISE_AI_MCP_REGISTRY_ENABLED=false
LANGSMITH_TRACING=false

# Optional tracing preserved from the deployed V4 backend; disabled by default.
# Use either Langfuse or LangSmith, not both. Keep real keys in private runtime config.
LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_BASE_URL=https://your-langfuse-endpoint
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_ENVIRONMENT=poc
