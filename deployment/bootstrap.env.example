# Per-app console environment. Never put real secrets in this file.
OCI_REGION=ap-hyderabad-1
OCI_AUTH_MODE=resource_principal
APP_CONFIG_NAMESPACE=<object-storage-namespace>
APP_CONFIG_BUCKET=<private-config-bucket>
APP_CONFIG_OBJECT_NAME=backend-v1.json
# Other object names: retail-agent-v1.json, supplier-agent-v1.json, mcp-v1.json
